# ── AI Provider Keys ──────────────────────────────────────────────────────────
# Put ONE key (or more — first available wins). The proxy auto-detects which
# backend to use. See README for details.
#
# Priority: OPENROUTER_API_KEY > ANTHROPIC_API_KEY > OPENAI_API_KEY

# Recommended — free tier available, access to many models
OPENROUTER_API_KEY=sk-or-v1-...

# Claude / Anthropic direct (legacy fallback)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI direct
# OPENAI_API_KEY=sk-...

# ── Model Selection ───────────────────────────────────────────────────────────
# Default models per role. If unset, sensible per-provider defaults are used.
# Uncomment and change to override.

# Unified model — vision + tools in one agent loop
# MODEL=google/gemini-2.5-flash
# VISION_MODEL=google/gemini-2.5-flash
# TEXT_MODEL=deepseek/deepseek-v4-flash

# ── Optional Services ─────────────────────────────────────────────────────────

# Composio — SaaS connections (Slack, Gmail, Notion, GitHub, etc.)
# COMPOSIO_API_KEY=your-composio-api-key

# Speech-to-text — optional but recommended for AssemblyAI provider
# ASSEMBLYAI_API_KEY=your-assemblyai-key

# Text-to-speech — makes Teachy sound human (strongly recommended)
# ElevenLabs (best quality) OR OpenAI TTS as fallback
# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=kPzsL2i3teMYv0FxEYQ6
# OPENAI_API_KEY also enables OpenAI TTS (gpt-4o-mini-tts / voice nova) if ElevenLabs is unset

# ── Proxy Settings ────────────────────────────────────────────────────────────

# Optional: proxy listen port (default 8787)
# PORT=8787
