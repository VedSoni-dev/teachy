{
  "manifest_version": 3,
  "name": "Teachy",
  "short_name": "Teachy",
  "version": "0.1.0",
  "description": "Lets Teachy on your Mac work in this browser for you, in its own tab group. You watch; Escape takes it back. Needs the Teachy app.",
  "minimum_chrome_version": "116",
  "key": "",
  "incognito": "not_allowed",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Teachy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
