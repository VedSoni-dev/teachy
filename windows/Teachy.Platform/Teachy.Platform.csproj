<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Teachy.Platform</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Pulls in UIAutomationClient/UIAutomationTypes for the element inspector. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Enabling UseWPF swaps in the WPF implicit-usings set, which drops System.IO. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Teachy.Engine\Teachy.Engine.csproj" />
  </ItemGroup>

</Project>
