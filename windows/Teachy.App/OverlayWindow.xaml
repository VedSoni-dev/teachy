<Window x:Class="Teachy.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TeachyOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Canvas x:Name="OverlayCanvas">

        <!-- Pulsing ring shown while pointing at a target -->
        <Ellipse x:Name="PointingRing"
                 Width="46" Height="46"
                 Stroke="#FF0A84FF" StrokeThickness="3"
                 Opacity="0" />

        <!-- The glowing Teachy triangle cursor — same mark as the mac companion -->
        <Grid x:Name="CompanionCursor" Width="30" Height="30" Opacity="0">
            <Polygon Points="3.72,0.59 5.63,22.51 23.65,9.90" Fill="#FF0A84FF" Width="24" Height="23"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"
                     RenderTransformOrigin="0.5,0.5">
                <Polygon.RenderTransform>
                    <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
                </Polygon.RenderTransform>
                <Polygon.Effect>
                    <BlurEffect Radius="8" />
                </Polygon.Effect>
            </Polygon>
            <Polygon Points="3.05,0.48 4.61,18.42 19.35,8.10" Fill="#FF0A84FF" Width="20" Height="19"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polygon.Effect>
                    <DropShadowEffect Color="#0A84FF" BlurRadius="10" ShadowDepth="0" Opacity="0.75" />
                </Polygon.Effect>
            </Polygon>
        </Grid>

        <!-- Response bubble next to the cursor -->
        <Border x:Name="ResponseBubble"
                MaxWidth="380"
                Background="#F2181410"
                CornerRadius="14"
                Padding="15,11"
                BorderBrush="#22D9A455"
                BorderThickness="1"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.5" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="ResponseStatusText"
                           Text="listening…"
                           Foreground="#D9A455"
                           FontFamily="Bahnschrift SemiBold" FontSize="10.5"
                           Margin="0,0,0,5"
                           Visibility="Collapsed" />
                <TextBlock x:Name="ResponseBodyText"
                           Text=""
                           Foreground="#F3EDE4"
                           FontFamily="Corbel" FontSize="13.5"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

    </Canvas>
</Window>
